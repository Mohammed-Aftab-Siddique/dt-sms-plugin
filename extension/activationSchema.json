{
  "types": {
    "managementZone": {
      "type": "object",
      "summaryPattern": "{name}",
      "properties": {
        "name": {
          "displayName": "Management Zone",
          "type": "text",
          "nullable": false,
          "constraints": [
            {
              "type": "LENGTH",
              "minLength": 1,
              "maxLength": 500
            }
          ]
        }
      }
    },
    "recipient": {
      "type": "object",
      "summaryPattern": "{number}",
      "properties": {
        "number": {
          "displayName": "Phone Number",
          "type": "text",
          "nullable": false,
          "constraints": [
            {
              "type": "LENGTH",
              "minLength": 1,
              "maxLength": 50
            }
          ]
        }
      }
    },
    "pythonRemote": {
      "type": "object",
      "properties": {
        "dynatraceUrl": {
          "displayName": "Dynatrace Tenant URL",
          "type": "string",
          "nullable": false
        },
        "dynatraceApiToken": {
          "displayName": "Dynatrace API Token",
          "type": "string",
          "nullable": false,
          "format": "password"
        },
        "pollingInterval": {
          "displayName": "Polling Interval (seconds)",
          "type": "integer",
          "nullable": false,
          "default": 300,
          "constraints": [
            {
              "type": "RANGE",
              "minimum": 1,
              "maximum": 86400
            }
          ]
        },
        "lookbackWindow": {
          "displayName": "Lookback Window (minutes)",
          "type": "integer",
          "nullable": false,
          "default": 5,
          "constraints": [
            {
              "type": "RANGE",
              "minimum": 1,
              "maximum": 1440
